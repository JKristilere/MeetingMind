# ─────────────────────────────────────────
# MeetingMind — Environment Configuration
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# App
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-secret
APP_FRONTEND_URL=http://localhost:5173
APP_BACKEND_URL=http://localhost:8000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=meetingmind
POSTGRES_USER=meetingmind
POSTGRES_PASSWORD=meetingmind_secret

# Redis (Celery broker + cache)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MinIO (object storage for audio/video)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET_AUDIO=meetingmind-audio
MINIO_BUCKET_TRANSCRIPTS=meetingmind-transcripts
MINIO_SECURE=false

# ─── Transcription ───────────────────────
# Provider: "whisper" (local, free) | "azure" (cloud)
TRANSCRIPTION_PROVIDER=whisper

# Faster-Whisper (local — recommended for cost savings)
WHISPER_MODEL_SIZE=medium          # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu                 # cpu | cuda
WHISPER_COMPUTE_TYPE=int8          # int8 | float16 | float32

# Azure Speech (optional — set TRANSCRIPTION_PROVIDER=azure to use)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ─── LLM / AI Analysis ───────────────────
# Provider: "ollama" (local, free) | "anthropic" | "openai" | "azure_openai"
LLM_PROVIDER=ollama

# Ollama (local — pull model with: ollama pull llama3.2)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Anthropic Claude (recommended for quality)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Azure OpenAI
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ─── Notifications ────────────────────────
# WhatsApp via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@meetingmind.app
SMTP_FROM_NAME=MeetingMind

# ─── Auth ─────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Billing / Paystack ───────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ─── Feature Flags ────────────────────────
ENABLE_GOOGLE_MEET_BOT=false
ENABLE_ZOOM_BOT=false
ENABLE_WHATSAPP_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
